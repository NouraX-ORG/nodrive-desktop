#
# NoDrive branding overlay. GENERATED by tools/rebrand.py from
# tools/branding/ids.json - edit ids.json and re-run the tool instead.
#
# CMakeLists.txt includes this file right after NEXTCLOUD.cmake and the
# CfApi block. Plain set() creates normal variables, which shadow cache
# entries, so a -D on the command line (or from KDE Craft) cannot undo
# these product facts. New upstream options keep their defaults.

# --- Names and ids (plan section 2) ---
set(APPLICATION_NAME "NoDrive")
set(APPLICATION_SHORTNAME "NoDrive")
set(APPLICATION_EXECUTABLE "nodrive")
set(APPLICATION_CONFIG_NAME "nodrive")
set(APPLICATION_ICON_NAME "NoDrive")
set(APPLICATION_VENDOR "Nourax")
set(APPLICATION_DOMAIN "drive.nourax.org")
set(APPLICATION_REV_DOMAIN "org.nourax.nodrive.desktop")
set(APPLICATION_REV_DOMAIN_DBUS "desktop.nodrive.nourax.org")
set(APPLICATION_REV_DOMAIN_INSTALLER "org.nourax.nodrive.desktop")
set(LINUX_PACKAGE_SHORTNAME "nodrive")
set(LINUX_APPLICATION_ID "org.nourax.nodrive.desktop.nodrive")
set(APPLICATION_VIRTUALFILE_SUFFIX "nodrive")
set(DEVELOPMENT_TEAM "NOURAXTEAM")
set(DBUS_PREFIX "org")
# Kept on purpose: the server's web UI builds nc://open/... links ("Open locally").
set(APPLICATION_URI_HANDLER_SCHEME "nc")

# --- Version: <upstream>-nourax.<n> ---
set(NODRIVE_RELEASE 1)
set(MIRALL_VERSION_SUFFIX "-nourax.${NODRIVE_RELEASE}")

# --- Fixed server, browser sign-in (Login Flow v2) ---
set(APPLICATION_SERVER_URL "https://drive.nourax.org")
set(APPLICATION_SERVER_URL_ENFORCE ON)

# --- Links ---
# Help link. Must never be empty: an empty value makes theme.cpp fall back
# to upstream's documentation site. Override with -DNODRIVE_HELP_URL=...
set(NODRIVE_HELP_URL "https://drive.nourax.org" CACHE STRING "NoDrive help link (must not be empty)")
set(APPLICATION_HELP_URL "${NODRIVE_HELP_URL}")
# Privacy-policy link. Empty = the link is hidden (owner to-do: real URL).
set(NOURAX_PRIVACY_URL "" CACHE STRING "Nourax privacy-policy URL; empty hides the link")
configure_file(${CMAKE_SOURCE_DIR}/nodrive/nodriveconfig.h.in ${CMAKE_BINARY_DIR}/nodrive/nodriveconfig.h)

# --- Switched off: updater, providers list, crash reporter, account import ---
set(BUILD_UPDATER OFF)
# theme.cpp needs a non-empty update URL to compile; it is never contacted
# because no updater code is built (BUILD_UPDATER OFF).
set(APPLICATION_UPDATE_URL "https://drive.nourax.org/")
set(WITH_PROVIDERS OFF)
set(WITH_CRASHREPORTER OFF)
# Do not import or show accounts of the real Nextcloud client (side by side).
set(DISABLE_ACCOUNT_MIGRATION ON)
set(APPLICATION_DISPLAY_LEGACY_IMPORT_DIALOG OFF)

# --- Look: Nourax colours and logo (tools/make-icons.py) ---
set(NEXTCLOUD_BACKGROUND_COLOR "#2563EB")
set(APPLICATION_WIZARD_HEADER_BACKGROUND_COLOR "#2563EB")
set(APPLICATION_WIZARD_HEADER_TITLE_COLOR "#FFFFFF")
set(APPLICATION_WIZARD_USE_CUSTOM_LOGO ON)
set(APPLICATION_ICON_SET "SVG")
# NEXTCLOUD.cmake decided the Icon Composer path while the name was still
# Nextcloud; NoDrive uses the classic .icns made from our PNGs.
set(MACOS_USE_ICON_COMPOSER OFF)

# --- Theme class (upstream hook THEME_CLASS / THEME_INCLUDE) ---
set(THEME_CLASS "NoDriveTheme")
set(THEME_INCLUDE "nodrivetheme.h")
include_directories(${CMAKE_SOURCE_DIR}/nodrive ${CMAKE_BINARY_DIR}/nodrive)

