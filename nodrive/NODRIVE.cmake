# --- Guards ---
if(NOT APPLICATION_HELP_URL)
    message(FATAL_ERROR "NoDrive: APPLICATION_HELP_URL must not be empty (empty falls back to the upstream documentation link)")
endif()
if(NOT APPLICATION_SERVER_URL OR NOT APPLICATION_SERVER_URL_ENFORCE)
    message(FATAL_ERROR "NoDrive: the server URL must be set and enforced")
endif()
message(STATUS "NoDrive branding: ${APPLICATION_NAME} by ${APPLICATION_VENDOR}, server ${APPLICATION_SERVER_URL}, version suffix ${MIRALL_VERSION_SUFFIX}")
